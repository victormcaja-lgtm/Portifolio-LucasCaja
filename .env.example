# Copie para .env (lido pelo Next, pelo Prisma e pelo Docker Compose) e preencha.
# Nunca versione .env nem .env.local.
# Variáveis comentadas como "Etapa N" pertencem a etapas ainda não implementadas.

# URL pública do site (metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Etapa 4 — PostgreSQL (Docker local na porta 5434: npm run db:up)
# Valores APENAS de desenvolvimento; em produção use as credenciais do provedor.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# Somente servidor. Define a fonte do conteúdo público:
#   - definida: as páginas leem do banco (inacessível → o build falha, sem cair no demo);
#   - ausente ou vazia: conteúdo de demonstração (build sem banco: `DATABASE_URL= npm run build`).
# Em produção na Vercel (VERCEL_ENV=production) é obrigatória. Não é necessária para prisma generate.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5434/portfolio?schema=public
# Conexão DIRETA (sem pooler), usada só pela CLI do Prisma (migrações). Criada pela integração
# Neon na Vercel; localmente não é necessária (vale DATABASE_URL). Ver prisma.config.ts.
# DATABASE_URL_UNPOOLED=
# Banco dos testes de integração (criado pelo script de init do Docker).
# TEST_DATABASE_URL=postgresql://portfolio:portfolio@localhost:5434/portfolio_test?schema=public

# Etapa 5 — Better Auth (autenticação do /admin). Somente servidor.
# O build e as páginas públicas NÃO dependem destas variáveis; sem elas, só o /admin fica indisponível.
# Segredo de assinatura das sessões, com pelo menos 32 caracteres. Gere com: openssl rand -base64 32
# Use valores diferentes no computador e na Vercel (docs/GUIA-CONFIGURACAO.md, seção 2).
BETTER_AUTH_SECRET=
# Endereço em que o site roda, sem barra no final:
#   - local: http://localhost:3000;
#   - produção (Vercel, ambiente Production): https://portifolio-lucas-caja.vercel.app;
#   - preview da Vercel: deixe SEM valor; o código usa https://${VERCEL_URL}, definida pela Vercel.
BETTER_AUTH_URL=http://localhost:3000
# Primeiro OWNER, usado só pelo script `npm run auth:owner` (não precisa ir para a Vercel).
# O script imprime um link de uso único (60 min) para definir a senha no navegador.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=

# Etapa 6 — Cloudinary (Console > Settings > API Keys)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=   # segredo: somente servidor
# CLOUDINARY_UPLOAD_FOLDER=portfolio
