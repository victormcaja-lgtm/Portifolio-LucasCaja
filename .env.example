# Copie para .env.local e preencha. Nunca versione .env.local.
# Variáveis marcadas como "etapa N" ainda não são usadas pelo código.

# URL pública do site (metadata, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Etapa 4 — PostgreSQL (Docker local na porta 5434)
# DATABASE_URL=postgresql://portfolio:portfolio@localhost:5434/portfolio?schema=public

# Etapa 5 — Better Auth
# BETTER_AUTH_SECRET=   # gere com: openssl rand -base64 32
# BETTER_AUTH_URL=http://localhost:3000
# SEED_OWNER_EMAIL=
# SEED_OWNER_NAME=

# Etapa 6 — Cloudinary (Console > Settings > API Keys)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=   # segredo: somente servidor
# CLOUDINARY_UPLOAD_FOLDER=portfolio
